{
  "name": "kairos-vscode-debugger",
  "displayName": "Kairos VS Code Debugger",
  "description": "Official VS Code support for Kairos with DAP debugging, reverse execution controls, and built-in language features.",
  "version": "0.2.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicologiuliani6/kairos-vscode-debugger"
  },
  "publisher": "nico",
  "homepage": "https://github.com/nicologiuliani6/kairos-vscode-debugger",
  "bugs": {
    "url": "https://github.com/nicologiuliani6/kairos-vscode-debugger/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Debuggers", "Programming Languages"],
  "keywords": [
    "kairos",
    "debugger",
    "dap",
    "reverse-debugging",
    "vscode",
    "language-support"
  ],
  "activationEvents": [
    "onDebugResolve:kairos",
    "onLanguage:kairos"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "kairos",
        "extensions": [".kairos"],
        "aliases": ["Kairos"]
      }
    ],
    "grammars": [
      {
        "language": "kairos",
        "scopeName": "source.kairos",
        "path": "./syntaxes/kairos.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "kairos"
      }
    ],
    "debuggers": [
      {
        "type": "kairos",
        "label": "Kairos Debug",
        "languages": ["kairos"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .kairos file to run"
              },
              "kairosApp": {
                "type": "string",
                "description": "Path of the kairos executable"
              },
              "kairosLib": {
                "type": "string",
                "description": "Path of the debugger library dap.so (libvm_dap.so)"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false
              }
            }
          }
        }
      }
    ],
    "configuration": {
      "title": "Kairos",
      "properties": {
        "kairos.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python interpreter (only to run Kairos from a source checkout)."
        },
        "kairos.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Root of a Kairos source checkout (only when not using the installed kairos package)."
        },
        "kairos.appPath": {
          "type": "string",
          "default": "/usr/local/bin/kairos",
          "description": "Path of the kairos executable. When set, it takes priority over kairos.projectRoot."
        },
        "kairos.libPath": {
          "type": "string",
          "default": "/usr/local/lib/kairos/dap.so",
          "description": "Path of the debugger library (dap.so, or build/libvm_dap.so in a source checkout)."
        }
      }
    },
    "commands": [
      {
        "command": "kairos.selectInterpreter",
        "title": "Kairos: Select Python interpreter"
      },
      {
        "command": "kairos.selectRoot",
        "title": "Kairos: Select project root"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "koffi": "^2.0.0",
    "@vscode/debugadapter": "^1.61.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/vscode": "^1.80.0",
    "@vscode/debugprotocol": "^1.61.0",
    "typescript": "^5.0.0"
  }
}